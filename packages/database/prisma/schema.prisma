// ---------------------------------------------------------------
// QAZAQ TAS ERP — схема базы данных
// СУБД: MariaDB 10.4 (провайдер mysql)
//
// Этап 0: пользователи, авторизация, журнал действий.
// Этап 1 расширяет схему до полного домена (клиенты, лиды, сделки,
// товары, заказы, производство, склад, закупки, логистика, финансы).
//
// ВАЖНО: значения enum обязаны совпадать с packages/shared/src/enums.ts
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Роли пользователей системы
enum UserRole {
  DIRECTOR // Директор — видит весь бизнес
  SALES_MANAGER // Менеджер продаж
  PRODUCTION // Производство
  WAREHOUSE // Склад
  ACCOUNTANT // Бухгалтер
  ADMIN // Администратор системы
}

/// Пользователь системы
model User {
  id               String    @id @default(uuid())
  email            String    @unique @db.VarChar(191)
  passwordHash     String    @db.VarChar(255)
  fullName         String    @db.VarChar(191)
  phone            String?   @db.VarChar(32)
  position         String?   @db.VarChar(191)
  role             UserRole  @default(SALES_MANAGER)
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?   @db.VarChar(255)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

/// Refresh-токен сессии (для выхода со всех устройств и отзыва доступа)
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @db.VarChar(255)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.VarChar(255)
  ipAddress String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Журнал действий: кто, что и когда изменил (требование раздела «Безопасность»)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(64) // CREATE, UPDATE, DELETE, LOGIN, EXPORT...
  entity    String   @db.VarChar(64) // Order, Client, Product...
  entityId  String?  @db.VarChar(64)
  changes   Json? // что именно изменилось: { поле: [было, стало] }
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// Каталог продукции (этап 2)
// ---------------------------------------------------------------

/// Единицы измерения продукции
enum Unit {
  M2 // квадратный метр
  M3 // кубический метр
  MP // метр погонный
  PCS // штука
  KG // килограмм
  TON // тонна
  L // литр
}

/// Категория продукции: брусчатка, бордюр, дренаж, МАФ и т.д.
model Category {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(191)
  nameKk         String?  @db.VarChar(191)
  slug           String   @unique @db.VarChar(191)
  description    String?  @db.Text
  descriptionKk  String?  @db.Text
  imageUrl       String?  @db.VarChar(512)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?  @db.VarChar(255)
  seoDescription String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

/// Товар каталога
model Product {
  id               String   @id @default(uuid())
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             String   @db.VarChar(191)
  nameKk           String?  @db.VarChar(191)
  slug             String   @unique @db.VarChar(191)
  sku              String?  @unique @db.VarChar(64)
  shortDescription String?  @db.VarChar(500)
  shortDescriptionKk String? @db.VarChar(500)
  description      String?  @db.Text
  descriptionKk    String?  @db.Text
  unit             Unit     @default(M2)
  /// Цена за единицу измерения, тенге
  price            Decimal  @db.Decimal(12, 2)
  oldPrice         Decimal? @db.Decimal(12, 2)
  /// Размеры изделия, например «300x300x60 мм»
  dimensions       String?  @db.VarChar(191)
  /// Доступные цвета: ["Серый", "Красный"]
  colors           Json?
  /// Характеристики: {"Морозостойкость": "F200", "Прочность": "М400"}
  specs            Json?
  inStock          Boolean  @default(true)
  /// Остаток на складе (заполняется автоматически с этапа 7)
  stockQuantity    Decimal? @db.Decimal(12, 3)
  isPublished      Boolean  @default(false)
  sortOrder        Int      @default(0)
  seoTitle         String?  @db.VarChar(255)
  seoDescription   String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  images    ProductImage[]
  documents ProductDocument[]

  @@index([categoryId, isPublished])
  @@index([isPublished, sortOrder])
  @@map("products")
}

/// Фотография или видео товара
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.VarChar(512)
  alt       String?  @db.VarChar(255)
  isMain    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Сертификат, паспорт качества или другой документ товара
model ProductDocument {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(191)
  url       String   @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_documents")
}

// ---------------------------------------------------------------
// Мультиязычность и настройки сайта (этап 3)
// ---------------------------------------------------------------

/// Языки сайта
enum Locale {
  RU // русский
  KK // казахский
}

/// Строка перевода интерфейса. Редактируется в админке без программиста.
model Translation {
  id        String   @id @default(uuid())
  /// Ключ вида "hero.title", "nav.catalog"
  key       String   @unique @db.VarChar(191)
  /// Раздел для группировки в админке: "Шапка", "Главная", "Каталог"
  group     String   @default("Общее") @db.VarChar(64)
  ru        String   @db.Text
  kk        String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("translations")
}

/// Настройка сайта: телефон, WhatsApp, адрес, реквизиты.
model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(191)
  value     String   @db.Text
  group     String   @default("Общее") @db.VarChar(64)
  /// Подпись поля в админке
  label     String   @db.VarChar(191)
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_settings")
}

/// Баннер на главной странице со ссылкой
model Banner {
  id         String   @id @default(uuid())
  titleRu    String   @db.VarChar(255)
  titleKk    String   @db.VarChar(255)
  subtitleRu String?  @db.VarChar(500)
  subtitleKk String?  @db.VarChar(500)
  imageUrl   String?  @db.VarChar(512)
  /// Куда ведёт баннер
  linkUrl    String?  @db.VarChar(512)
  linkTextRu String?  @db.VarChar(191)
  linkTextKk String?  @db.VarChar(191)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}
