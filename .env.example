# ---------------------------------------------------------------
# QAZAQ TAS ERP — образец переменных окружения
# Скопируйте в .env и подставьте свои значения: cp .env.example .env
# Файл .env в git НЕ попадает.
# ---------------------------------------------------------------

# --- База данных (MariaDB 10.4) ---
DATABASE_URL="mysql://qazaqtas:qazaqtas_password@localhost:3306/qazaq_tas"

# Параметры контейнера MariaDB (docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=qazaq_tas
MYSQL_USER=qazaqtas
MYSQL_PASSWORD=qazaqtas_password
DB_PORT=3306
PHPMYADMIN_PORT=8080

# --- API (NestJS) ---
API_PORT=3001
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# --- Авторизация (JWT) ---
JWT_SECRET=change_me_to_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# --- Сброс кеша сайта ---
# Общий секрет: API сообщает сайту, что содержимое изменилось.
REVALIDATE_SECRET=change_me_to_random_string
WEB_URL=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp через Kelesu (этап 4) ---
KELESU_API_URL=
KELESU_API_KEY=
KELESU_WEBHOOK_SECRET=

# --- AI-помощник (этап 11) ---
ANTHROPIC_API_KEY=
